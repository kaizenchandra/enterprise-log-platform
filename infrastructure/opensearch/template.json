{
  "index_patterns": [
    "logs-*"
  ],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.mapping.total_fields.limit": 64
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "log_id": {
          "type": "keyword"
        },
        "tenant_id": {
          "type": "keyword"
        },
        "source_id": {
          "type": "keyword"
        },
        "service_name": {
          "type": "keyword"
        },
        "environment": {
          "type": "keyword"
        },
        "severity": {
          "type": "keyword"
        },
        "trace_id": {
          "type": "keyword"
        },
        "span_id": {
          "type": "keyword"
        },
        "event_timestamp": {
          "type": "date"
        },
        "ingestion_timestamp": {
          "type": "date"
        },
        "message": {
          "type": "text"
        },
        "attributes": {
          "type": "object",
          "enabled": false
        },
        "schema_version": {
          "type": "integer"
        }
      }
    }
  }
}